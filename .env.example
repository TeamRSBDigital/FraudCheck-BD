# FraudCheck BD — server-side configuration
# Never commit real production secrets.

# Required for live courier lookups.
# Copy the exact endpoint and credential format from:
# https://courier.com.bd/api-docs#endpoints
BDCOURIER_API_URL=""
BDCOURIER_API_KEY=""

# Auth/body mapping. Keep these aligned with the official API documentation.
BDCOURIER_AUTH_HEADER="Authorization"
BDCOURIER_AUTH_SCHEME="Bearer"
BDCOURIER_API_KEY_LOCATION="header"
BDCOURIER_API_KEY_FIELD="api_key"
BDCOURIER_PHONE_FIELD="phone"
BDCOURIER_TIMEOUT_MS="8000"

# Demo mode is OFF by default. Never enable this for real customer decisions.
ENABLE_DEMO_MODE="false"

# Free-check quota.
DAILY_FREE_LIMIT="50"

# Bangladesh Standard Time (UTC+6), used for daily quota reset.
RATE_LIMIT_TIMEZONE_OFFSET_MINUTES="360"

# Use a long random secret so stored rate-limit keys never contain raw IP addresses.
RATE_LIMIT_SALT=""

# Recommended for Vercel/serverless so rate-limit counters persist across instances.
# Create an Upstash Redis database and add its REST credentials.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
