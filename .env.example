# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# FraudCheck BD Configuration
# ==============================================================================

# BD Courier API Base Endpoint
# Official endpoint provided upon registration at https://bdcourier.com
BDCOURIER_API_URL="https://api.bdcourier.com/courier-check"

# BD Courier API Authentication Key / Bearer Token
# Required for live courier checking in production.
# If omitted or left empty, FraudCheck BD safely operates in development sandbox mode.
BDCOURIER_API_KEY=""

# Daily Free Limit per IP / User
# Default: 50 checks per calendar day (resets daily at 00:00 UTC)
DAILY_FREE_LIMIT=50

# Redis Connection URL (Optional)
# If provided, rate limits are stored in Redis across distributed serverless instances.
# If omitted, a high-performance in-memory rate limiter with daily TTL is used.
REDIS_URL=""

# Public Application Metadata
VITE_SITE_NAME="FraudCheck BD"
VITE_SITE_URL="https://fraudcheckbd.com"
