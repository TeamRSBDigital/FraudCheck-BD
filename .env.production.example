# FraudCheck BD — Vercel Production Environment Variables
# TEMPLATE ONLY. Never commit real secrets or paste real API keys into GitHub.
#
# Recommended Vercel scopes:
# - Production: all values below
# - Preview: use separate test/provider credentials where available
# - Development: keep secrets in .env.local (gitignored)

# ============================================================
# 1) REQUIRED — Live courier provider
# ============================================================

# Exact HTTPS endpoint from the authorized courier.com.bd API account/docs.
BDCOURIER_API_URL="https://REPLACE_WITH_OFFICIAL_ENDPOINT"

# Secret production API key. Add as an encrypted/sensitive Vercel variable.
BDCOURIER_API_KEY="REPLACE_WITH_SECRET_API_KEY"

# ============================================================
# 2) PROVIDER REQUEST MAPPING
# Change these only if the official provider docs require it.
# ============================================================

BDCOURIER_AUTH_HEADER="Authorization"
BDCOURIER_AUTH_SCHEME="Bearer"
BDCOURIER_API_KEY_LOCATION="header"
BDCOURIER_API_KEY_FIELD="api_key"
BDCOURIER_PHONE_FIELD="phone"
BDCOURIER_TIMEOUT_MS="8000"

# ============================================================
# 3) REQUIRED FOR RELIABLE PUBLIC RATE LIMITING ON VERCEL
# ============================================================

# Create/connect an Upstash Redis store via Vercel Marketplace.
UPSTASH_REDIS_REST_URL="https://REPLACE_WITH_UPSTASH_REST_URL"
UPSTASH_REDIS_REST_TOKEN="REPLACE_WITH_UPSTASH_REST_TOKEN"

# Long random secret used to HMAC-hash client identifiers before Redis storage.
# Generate with: openssl rand -hex 32
RATE_LIMIT_SALT="REPLACE_WITH_64_HEX_RANDOM_SECRET"

# ============================================================
# 4) APP LIMIT POLICY
# ============================================================

# Free lookup attempts per client/IP per Bangladesh calendar day.
DAILY_FREE_LIMIT="50"

# Bangladesh Standard Time = UTC+6 = 360 minutes.
RATE_LIMIT_TIMEZONE_OFFSET_MINUTES="360"

# No DEMO_MODE / MOCK_MODE / SANDBOX_MODE variable exists.
# FraudCheck BD is live-data-only.
